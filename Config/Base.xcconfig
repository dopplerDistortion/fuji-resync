// Shared build settings. Personal signing lives in Config/Local.xcconfig (gitignored).
// Copy Config/Local.xcconfig.example to Config/Local.xcconfig and put your team ID in it.

// Entitlements any team can sign. Local.xcconfig can point this at Resync-Hotspot.entitlements.
RESYNC_ENTITLEMENTS = App/Support/Resync.entitlements

// A public Mapbox token (pk.…) goes in Local.xcconfig, never here: the repo is public. With no
// token the app keeps Apple's map.
MAPBOX_ACCESS_TOKEN =

#include? "Local.xcconfig"
